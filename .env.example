NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fleetcore
DB_PASSWORD=fleetcore_local_example
DB_DATABASE=fleetcore
JWT_SECRET=example-only-replace-with-a-long-random-secret
API_KEY=example-only-replace-with-a-random-api-key

# Docker Compose sets DB_HOST=postgres and DB_PORT=5432 inside containers.
# PORT controls the HTTP port published on the host.

# Optional GitHub OAuth: configure all three values to enable sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
